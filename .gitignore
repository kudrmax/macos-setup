# macOS
**/.DS_Store

# Бэкапы, создаваемые sync.sh перед заменой на симлинки
.backup/

# Karabiner автобэкапы (генерируются автоматически)
home/.config/karabiner/automatic_backups/


# Bruno секреты
home/Library/Application Support/bruno/secrets.json
home/Library/Application Support/bruno/cookies.json
home/Library/Application Support/bruno/collection-security.json

# MPV личные данные (история просмотров, закладки)
home/.config/mpv/mpvHistory.log
home/.config/mpv/mpvBookmark.log
home/.config/mpv/bookmarks.json
home/.config/mpv/bookmarker.json

/docs/superpowers/plans

# Python-кэш от скриптов скиллов
__pycache__/
*.pyc

# Claude Desktop сам пишет сюда состояние сессий и ID аккаунтов — не синхронизируется
home/Library/Application Support/Claude/claude_desktop_config.json
