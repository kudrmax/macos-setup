# macOS
**/.DS_Store

# Python-кэш
__pycache__/
*.pyc

# Karabiner автобэкапы (генерируются автоматически)
.config/karabiner/automatic_backups/

# iTerm2 служебное (сокеты), создаёт сам
.config/iterm2/sockets/

# Bruno секреты
Library/Application Support/bruno/secrets.json
Library/Application Support/bruno/cookies.json
Library/Application Support/bruno/collection-security.json

# MPV личные данные (история просмотров, закладки)
.config/mpv/mpvHistory.log
.config/mpv/mpvBookmark.log
.config/mpv/bookmarks.json
.config/mpv/bookmarker.json

# Claude Desktop сам пишет сюда состояние сессий и ID аккаунтов — не синхронизируется
Library/Application Support/Claude/claude_desktop_config.json
