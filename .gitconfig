[credential]
	helper = osxkeychain
[user]
	name = Maksim Kudryashov
	email = mdmkudryashov@avito.ru
[alias]
	st = status
	ch = checkout
	br = branch
	dog = log --oneline --graph
[core]
	pager = delta
	editor = true
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
[init]
	defaultBranch = master
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
