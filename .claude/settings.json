{
  "agentPushNotifEnabled": true,
  "editorMode": "normal",
  "effortLevel": "high",
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "async": true,
            "command": "/usr/local/bin/avito internal-claude-hook SessionStart",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "async": true,
            "command": "/usr/local/bin/avito internal-claude-hook SubagentStart",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "async": true,
            "command": "/usr/local/bin/avito internal-claude-hook SubagentStop",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|.*preview_start",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/guard-anki-port.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|mcp__Claude_Code_iOS_Simulator__.*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/guard-ios-sim.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "inputNeededNotifEnabled": true,
  "language": "Русский",
  "model": "opus[1m]",
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Read",
      "Bash(python --version)",
      "Bash(python3 --version)",
      "Bash(python -m venv:*)",
      "Bash(python3 -m venv:*)",
      "Bash(python -c:*)",
      "Bash(python3 -c:*)",
      "Bash(.venv/bin/python:*)",
      "Bash(.venv/bin/pip:*)",
      "Bash(source .venv/bin/activate:*)",
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go run:*)",
      "Bash(go mod:*)",
      "Bash(go vet:*)",
      "Bash(go fmt:*)",
      "Bash(go version)",
      "Bash(pytest:*)",
      "Bash(mypy:*)",
      "Bash(ruff:*)",
      "Bash(golangci-lint:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose build:*)",
      "Bash(which:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(wc:*)",
      "Bash(brew list:*)",
      "Bash(brew info:*)",
      "Bash(brew search:*)",
      "Bash(trash:*)",
      "Bash(baton:*)"
    ],
    "defaultMode": "auto",
    "deny": [
      "Bash(rm:*)",
      "Bash(unlink:*)",
      "Bash(rmdir:*)"
    ]
  },
  "preferredNotifChannel": "terminal_bell",
  "remoteControlAtStartup": false,
  "skipAutoPermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "statusLine": {
    "command": "~/.claude/statusline.sh",
    "type": "command"
  },
  "terminalProgressBarEnabled": true,
  "tui": "fullscreen",
  "verbose": true,
  "voice": {
    "enabled": true
  }
}
