# Пакеты для нового мака: brew bundle --global
# Проверка:  brew bundle check --global   (чего не хватает на машине)
#            brew bundle cleanup --global (что стоит, но здесь не записано; без --force только показывает)

# === Terminal ===
brew "powerlevel10k"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "zsh-history-substring-search"
brew "zsh-you-should-use"
brew "fzf"
brew "atuin"
brew "zoxide"
brew "micro"
cask "iterm2"

# === Современные замены CLI-утилит ===
brew "bat"       # cat
brew "eza"       # ls
brew "fd"        # find
brew "ripgrep"   # grep
brew "trash"     # rm (в корзину)
brew "jq"        # JSON (нужен statusline.sh)

# === Git ===
brew "lazygit"
brew "git-delta"
brew "gh"        # GitHub из терминала

# === Docker ===
brew "lazydocker"

# === Языки и рантаймы ===
brew "go"
brew "nvm"
brew "libpq"
brew "python"
brew "uv"        # установщик Python-пакетов и версий Python

# === Медиа ===
brew "yt-dlp"

# === Утилиты ===
brew "bitwarden-cli"
cask "maccy"
cask "bitwarden"
cask "appcleaner"
cask "bettertouchtool"
cask "karabiner-elements"
cask "sublime-text"

# === AI ===
cask "claude"
cask "claude-code@latest"

# === Приложения ===
cask "google-chrome"
cask "telegram"
cask "iina"
cask "todoist-app"
cask "obsidian"
cask "morgen"
cask "yandex-music"
cask "arc"
cask "bruno"
